{
  "name": "pivot-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Calculates the pivot point of a stock or index for a chosen date.",
  "scripts": {
    "test": "node --test",
    "collect": "node --max-old-space-size=4096 scripts/collect.js",
